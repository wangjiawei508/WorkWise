      "printedPages": [6, 8],
      "pdfPages": [9, 11],
      "summary": "A类错漏或任一元素/子元素低于60分直接导致单位成果不合格，不允许平均分抵消。"
    },
    {
      "id": "weights-and-penalties",
      "sourceId": "guizhou-full-text",
      "clauses": ["6.2.2", "6.2.3", "6.2.4.1", "6.2.4.2", "6.2.4.3", "6.2.4.4", "6.2.4.5"],
